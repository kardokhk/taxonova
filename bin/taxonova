#!/usr/bin/env python3

"""
Taxonova - Deep Learning-based Taxonomic Classification
Command-line interface for the Taxonova package.
"""

import sys
import os

# Add parent directory to path to ensure package is findable
project_root = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
sys.path.insert(0, project_root)

from taxonova.main import main

if __name__ == "__main__":
    sys.exit(main())
